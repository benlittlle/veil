<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sending goes through Messages via AppleScript, only after the user clicks Send. -->
  <key>com.apple.security.automation.apple-events</key><true/>
  <!-- Contact names in the chat list. The hardened runtime refuses Contacts without this, silently. -->
  <key>com.apple.security.personal-information.addressbook</key><true/>
</dict>
</plist>
